<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/system_blur_settings_title">

    <org.lunaris.settings.preferences.SystemSettingSwitchPreference
        android:key="dialog_blur_enabled"
        android:title="@string/dialog_blur_title"
        android:summary="@string/dialog_blur_summary"
        android:defaultValue="true" />

    <PreferenceCategory android:title="@string/system_blur_tint_category">
        <org.lunaris.settings.preferences.GlobalSettingSwitchPreference
            android:key="ax_blur_tint_override_enabled"
            android:title="@string/system_blur_tint_override_title"
            android:summary="@string/system_blur_tint_override_summary"
            android:defaultValue="false" />

        <org.lunaris.settings.preferences.GlobalSettingListPreference
            android:key="ax_blur_tint_override_mode"
            android:title="@string/system_blur_tint_mode_title"
            android:entries="@array/system_blur_tint_modes"
            android:entryValues="@array/system_blur_tint_mode_values"
            android:summary="%s"
            android:defaultValue="0"
            android:dependency="ax_blur_tint_override_enabled" />

        <org.lunaris.settings.preferences.colorpicker.GlobalSettingColorPickerPreference
            android:key="ax_blur_tint_override_color"
            android:title="@string/system_blur_custom_color_title"
            android:defaultValue="-12285185"
            android:dependency="ax_blur_tint_override_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_tint_override_alpha"
            android:title="@string/system_blur_tint_alpha_title"
            android:summary="@string/system_blur_tint_alpha_summary"
            android:min="0"
            android:max="100"
            android:defaultValue="50"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_tint_override_enabled" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/system_blur_radius_category">
        <org.lunaris.settings.preferences.GlobalSettingSwitchPreference
            android:key="ax_blur_radius_override_enabled"
            android:title="@string/system_blur_radius_override_title"
            android:summary="@string/system_blur_radius_override_summary"
            android:defaultValue="false" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_radius_override_dp"
            android:title="@string/system_blur_radius_title"
            android:min="0"
            android:max="60"
            android:defaultValue="34"
            settings:units="dp"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_radius_override_enabled" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/system_blur_rim_category">
        <org.lunaris.settings.preferences.GlobalSettingSwitchPreference
            android:key="ax_blur_rim_enabled"
            android:title="@string/system_blur_rim_title"
            android:summary="@string/system_blur_rim_summary"
            android:defaultValue="false" />

        <org.lunaris.settings.preferences.GlobalSettingListPreference
            android:key="ax_blur_rim_style"
            android:title="@string/system_blur_rim_style_title"
            android:entries="@array/system_blur_rim_styles"
            android:entryValues="@array/system_blur_rim_style_values"
            android:summary="%s"
            android:defaultValue="0"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.colorpicker.GlobalSettingColorPickerPreference
            android:key="ax_blur_rim_color"
            android:title="@string/system_blur_rim_color_title"
            android:defaultValue="-1"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_strength"
            android:title="@string/system_blur_rim_strength_title"
            android:max="100"
            android:defaultValue="100"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_top_alpha"
            android:title="@string/system_blur_rim_top_title"
            android:max="100"
            android:defaultValue="14"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_bottom_alpha"
            android:title="@string/system_blur_rim_bottom_title"
            android:max="100"
            android:defaultValue="50"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_side_alpha"
            android:title="@string/system_blur_rim_side_title"
            android:max="100"
            android:defaultValue="0"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingTenthSeekBarPreference
            android:key="ax_blur_rim_edge_width"
            android:title="@string/system_blur_rim_width_title"
            android:max="200"
            android:defaultValue="8"
            settings:units="dp"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingTenthSeekBarPreference
            android:key="ax_blur_rim_glow_depth"
            android:title="@string/system_blur_rim_depth_title"
            android:max="300"
            android:defaultValue="125"
            settings:units="dp"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_glow_alpha"
            android:title="@string/system_blur_rim_glow_title"
            android:max="100"
            android:defaultValue="30"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_corner_width_scale"
            android:title="@string/system_blur_rim_corner_width_title"
            android:summary="@string/system_blur_rim_corner_width_summary"
            android:max="100"
            android:defaultValue="100"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_corner_alpha_scale"
            android:title="@string/system_blur_rim_corner_brightness_title"
            android:max="100"
            android:defaultValue="80"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingTenthSeekBarPreference
            android:key="ax_blur_rim_corner_taper_power"
            android:title="@string/system_blur_rim_taper_title"
            android:summary="@string/system_blur_rim_taper_summary"
            android:min="1"
            android:max="80"
            android:defaultValue="68"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_light_angle"
            android:title="@string/system_blur_rim_light_angle_title"
            settings:min="0"
            android:max="360"
            android:defaultValue="131"
            settings:units="°"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_light_intensity"
            android:title="@string/system_blur_rim_light_intensity_title"
            settings:min="0"
            android:max="250"
            android:defaultValue="180"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_opposite_intensity"
            android:title="@string/system_blur_rim_opposite_intensity_title"
            settings:min="0"
            android:max="250"
            android:defaultValue="120"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingSeekBarPreference
            android:key="ax_blur_rim_light_angle_range"
            android:title="@string/system_blur_rim_light_angle_range_title"
            settings:min="15"
            android:max="100"
            android:defaultValue="70"
            settings:units="%"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingTenthSeekBarPreference
            android:key="ax_blur_rim_glass_edge_width"
            android:title="@string/system_blur_rim_glass_edge_width_title"
            settings:min="10"
            android:max="240"
            android:defaultValue="80"
            settings:units="dp"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />

        <org.lunaris.settings.preferences.GlobalSettingTenthSeekBarPreference
            android:key="ax_blur_rim_glass_edge_pow"
            android:title="@string/system_blur_rim_glass_edge_pow_title"
            android:summary="@string/system_blur_rim_glass_edge_pow_summary"
            settings:min="5"
            android:max="80"
            android:defaultValue="30"
            settings:continuousUpdates="true"
            android:dependency="ax_blur_rim_enabled" />
    </PreferenceCategory>
</PreferenceScreen>
